XIO IR -> AARCH64

ADD       -> add
SUB       -> sub
MUL       -> mul
SDIV      -> sdiv
UDIV      -> udiv
AND       -> and
OR        -> orr
XOR       -> eor
SHL       -> lsl
LSHR      -> lsr
ASHR      -> asr

LOAD      -> ldr
STORE     -> str
ADDRESS_OF -> add/adr/adrp

BRANCH    -> b
COND_BRANCH -> cmp + conditional branch
CALL      -> bl
RETURN    -> ret

SYSCALL   -> svc
TRAP      -> brk

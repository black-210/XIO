TARGET x86_64
BITS 64
ENDIAN little

GENERAL_REGISTERS
    rax rbx rcx rdx
    rsi rdi rbp rsp
    r8 r9 r10 r11 r12 r13 r14 r15

SUBREGISTERS
    al ah ax eax rax
    bl bh bx ebx rbx
    cl ch cx ecx rcx
    dl dh dx edx rdx
    sil si esi rsi
    dil di edi rdi
    bpl bp ebp rbp
    spl sp esp rsp
    r8b r8w r8d r8
    r9b r9w r9d r9
    r10b r10w r10d r10
    r11b r11w r11d r11
    r12b r12w r12d r12
    r13b r13w r13d r13
    r14b r14w r14d r14
    r15b r15w r15d r15

SPECIAL
    rip
    rflags

SIMD
    xmm0 xmm1 xmm2 xmm3
    xmm4 xmm5 xmm6 xmm7
    xmm8 xmm9 xmm10 xmm11
    xmm12 xmm13 xmm14 xmm15

INTEGER_INSTRUCTIONS
    mov
    movzx
    movsx
    lea
    add
    sub
    imul
    mul
    idiv
    div
    neg
    inc
    dec
    and
    or
    xor
    not
    shl
    shr
    sar
    rol
    ror

COMPARE
    cmp
    test
    sete
    setne
    setl
    setle
    setg
    setge
    seta
    setae
    setb
    setbe

CONTROL
    jmp
    je
    jne
    jl
    jle
    jg
    jge
    ja
    jae
    jb
    jbe
    call
    ret
    syscall
    sysret
    ud2

STACK
    push
    pop
    enter
    leave

ATOMIC
    lock
    xchg
    cmpxchg
    xadd
    mfence
    lfence
    sfence

SYSTEM
    syscall
    sysret
    cli
    sti
    hlt
    cpuid
    rdmsr
    wrmsr

ABI SYSV64
    integer_arguments rdi rsi rdx rcx r8 r9
    return rax rdx
    caller_saved rax rcx rdx rsi rdi r8 r9 r10 r11
    callee_saved rbx rbp r12 r13 r14 r15
    stack_alignment 16

STACK_RULES
    stack grows downward
    rsp alignment required at call boundary
    rbp optional

XIO_GRAMMAR 0.1

program        := declaration*

declaration    := module_decl
                | import_decl
                | type_decl
                | struct_decl
                | union_decl
                | enum_decl
                | trait_decl
                | impl_decl
                | global_decl
                | function_decl

module_decl    := "module" qualified_name ";"

import_decl    := "import" qualified_name ";"

type_decl      := "type" IDENTIFIER "=" type ";"

struct_decl    := "struct" IDENTIFIER "{" field* "}"

union_decl     := "union" IDENTIFIER "{" field* "}"

enum_decl      := "enum" IDENTIFIER "{" enum_variant* "}"

trait_decl     := "trait" IDENTIFIER "{" trait_item* "}"

impl_decl      := "impl" IDENTIFIER "for" type "{" declaration* "}"

global_decl    := modifiers? "global" IDENTIFIER ":" type initializer? ";"

function_decl  := modifiers? "fn" IDENTIFIER "(" parameters? ")" return_type? block

modifiers      := modifier*

modifier       := "public"
                | "private"
                | "internal"
                | "unsafe"
                | "inline"
                | "const"
                | "extern"
                | "noreturn"

parameters     := parameter ("," parameter)*

parameter      := IDENTIFIER ":" type

return_type    := "->" type

field          := modifiers? IDENTIFIER ":" type ";"

enum_variant   := IDENTIFIER
                | IDENTIFIER "(" parameters? ")"

trait_item     := function_decl
                | type_decl

type           := primitive
                | IDENTIFIER
                | pointer_type
                | reference_type
                | array_type
                | slice_type
                | tuple_type
                | function_type

primitive      := "u8"
                | "u16"
                | "u32"
                | "u64"
                | "u128"
                | "i8"
                | "i16"
                | "i32"
                | "i64"
                | "i128"
                | "usize"
                | "isize"
                | "f32"
                | "f64"
                | "bool"
                | "char"
                | "void"

pointer_type   := "*" modifiers? type

reference_type := "&" modifiers? type

array_type     := "[" expression "]" type

slice_type     := "[" "]" type

tuple_type     := "(" type ("," type)* ")"

function_type  := "fn" "(" parameters? ")" "->" type

block          := "{" statement* "}"

statement      := let_stmt
                | variable_stmt
                | expression_stmt
                | if_stmt
                | match_stmt
                | loop_stmt
                | while_stmt
                | for_stmt
                | return_stmt
                | break_stmt
                | continue_stmt
                | defer_stmt

let_stmt       := "let" IDENTIFIER ":" type initializer? ";"

variable_stmt  := "var" IDENTIFIER ":" type initializer? ";"

initializer    := "=" expression

expression_stmt := expression ";"

if_stmt        := "if" expression block
                  ("else" block | "else" if_stmt)?

match_stmt     := "match" expression "{"
                  match_arm*
                  "}"

match_arm      := pattern "=>" expression_or_block

loop_stmt      := "loop" block

while_stmt     := "while" expression block

for_stmt       := "for" IDENTIFIER "in" expression block

return_stmt    := "return" expression? ";"

break_stmt     := "break" ";"

continue_stmt  := "continue" ";"

defer_stmt     := "defer" expression_or_block

expression     := assignment

assignment     := logical_or
                | unary assignment_operator assignment

assignment_operator := "="
                     | "+="
                     | "-="
                     | "*="
                     | "/="
                     | "%="
                     | "&="
                     | "|="
                     | "^="
                     | "<<="
                     | ">>="

logical_or     := logical_and ("||" logical_and)*

logical_and    := bit_or ("&&" bit_or)*

bit_or         := bit_xor ("|" bit_xor)*

bit_xor        := bit_and ("^" bit_and)*

bit_and        := equality ("&" equality)*

equality       := comparison (("==" | "!=") comparison)*

comparison     := shift (("<" | "<=" | ">" | ">=") shift)*

shift          := additive (("<<" | ">>") additive)*

additive       := multiplicative (("+" | "-") multiplicative)*

multiplicative := unary (("*" | "/" | "%") unary)*

unary          := ("!" | "~" | "-" | "+" | "*" | "&") unary
                | postfix

postfix        := primary postfix_op*

postfix_op     := "(" arguments? ")"
                | "[" expression "]"
                | "." IDENTIFIER
                | "->" IDENTIFIER

arguments      := expression ("," expression)*

primary        := INTEGER
                | FLOAT
                | STRING
                | CHARACTER
                | "true"
                | "false"
                | IDENTIFIER
                | "(" expression ")"
                | array_literal
                | struct_literal

array_literal  := "[" arguments? "]"

struct_literal := IDENTIFIER "{"
                  named_argument*
                  "}"

named_argument := IDENTIFIER ":" expression ","

qualified_name := IDENTIFIER ("." IDENTIFIER)*

pattern        := IDENTIFIER
                | INTEGER
                | CHARACTER
                | "_"

expression_or_block := expression
                     | block

IDENTIFIER     := letter (letter | digit | "_")*

INTEGER        := decimal
                | hexadecimal
                | binary
                | octal

FLOAT          := digit+ "." digit+

STRING         := '"' string_character* '"'

CHARACTER      := "'" character "'"

COMMENT        := "//" .* newline
                | "/*" .* "*/"

WHITESPACE     := space | tab | newline


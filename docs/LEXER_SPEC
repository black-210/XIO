LEXER_RULE_IDENTIFIER
    letter := A-Z | a-z | _
    continuation := letter | digit
    identifier := letter continuation*

LEXER_RULE_DECIMAL
    digit := 0-9
    decimal := digit+

LEXER_RULE_HEXADECIMAL
    hexadecimal := 0x [0-9a-fA-F]+

LEXER_RULE_BINARY
    binary := 0b [01]+

LEXER_RULE_OCTAL
    octal := 0o [0-7]+

LEXER_RULE_FLOAT
    float := digit+ "." digit+ exponent?
    exponent := ("e" | "E") ("+" | "-")? digit+

LEXER_RULE_STRING
    string := '"' string_body '"'
    string_body := string_character*

LEXER_RULE_CHARACTER
    character := "'" character_body "'"

LEXER_RULE_COMMENT_LINE
    // consumes until newline

LEXER_RULE_COMMENT_BLOCK
    /* consumes until */

LEXER_RULE_WHITESPACE
    spaces and tabs are ignored except inside literals

LEXER_RULE_NEWLINE
    newline terminates logical statement when required

LEXER_RULE_ERROR
    unknown character produces diagnostic
    invalid escape produces diagnostic
    unterminated string produces diagnostic
    unterminated character produces diagnostic
    unterminated comment produces diagnostic
    invalid number produces diagnostic

LEXER_STATE_NORMAL
LEXER_STATE_STRING
LEXER_STATE_CHARACTER
LEXER_STATE_LINE_COMMENT
LEXER_STATE_BLOCK_COMMENT
LEXER_STATE_ATTRIBUTE
LEXER_STATE_DIRECTIVE

LEXER_POSITION
    file
    byte_offset
    line
    column
    length

TOKEN_DATA
    kind
    lexeme
    value
    position

LEXER_REQUIREMENTS
    deterministic
    zero_allocation_dependency
    unicode_aware_identifier_policy
    exact_source_position
    recoverable_errors
    comments_preserved_in_optional_mode
    numeric_literal_validation
    escape_validation
    keyword_lookup
    operator_longest_match
    eof_always_emitted

OPERATOR_MATCH
    longest_operator_first
    ">>=" before ">>"
    "<<=" before "<<"
    "->" before "-"
    "=>" before "="
    "==" before "="
    "!=" before "!"
    "<=" before "<"
    ">=" before ">"
    "&&" before "&"
    "||" before "|"
    "+=" before "+"
    "-=" before "-"
    "*=" before "*"
    "/=" before "/"
    "%=" before "%"
    "&=" before "&"
    "|=" before "|"
    "^=" before "^"

LEXER_OUTPUT
    token_stream
    diagnostics
    source_positions

LEXER_INVARIANTS
    never silently discard invalid input
    never confuse keyword and identifier
    never accept malformed numeric literal
    never accept malformed escape
    never lose source location
    never emit ambiguous operator token
